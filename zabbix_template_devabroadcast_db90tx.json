                        "triggers": [
                            {
                                "uuid": "78315a47a61e4d689d6fa23493da1611",
                                "expression": "min(/DEVABroadcast DB90TX by SNMP/icmppingloss,5m)>{$ICMP_LOSS_WARN} and min(/DEVABroadcast DB90TX by SNMP/icmppingloss,5m) < 100",
                                "name": "High ICMP ping loss",
                                "opdata": "Loss: {ITEM.LASTVALUE1}",
                                "priority": "WARNING",
                                "description": "Last three attempts returned timeout.  Please check device connectivity.",
                                "dependencies": [
                                    {
                                        "name": "Unavailable by ICMP ping",
                                        "expression": "max(/DEVABroadcast DB90TX by SNMP/icmpping,#3)=0"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "scope",
                                        "value": "availability"
                                    },
                                    {
                                        "tag": "scope",
                                        "value": "performance"
                                    }
                                ]
                            }
                        ]
