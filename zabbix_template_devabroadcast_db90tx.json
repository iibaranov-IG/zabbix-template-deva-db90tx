                    {
                        "uuid": "6eb13fcf4eaa43219ad578370305e215",
                        "name": "ICMP loss",
                        "type": "SIMPLE",
                        "key": "icmppingloss",
                        "value_type": "FLOAT",
                        "units": "%",
                        "tags": [
