                "discovery_rules": [
                    {
                        "uuid": "eb87208a43f5412e93224e892cd30e10",
                        "name": "Descubrimiento de Conexiones Stream",
                        "type": "SNMP_AGENT",
                        "snmp_oid": "discovery[{#SNMPVALUE}, .1.3.6.1.4.1.35833.8.3.3.1.1]",
                        "key": "stream.entry.discovery",
                        "delay": "1h",
                        "item_prototypes": [
                            {
                                "uuid": "e089ae9165aa4c44a9ff604bc43095d1",
                                "name": "Conexi\u00f3n {#SNMPINDEX}: Estado Activo",
                                "type": "SNMP_AGENT",
                                "snmp_oid": ".1.3.6.1.4.1.35833.8.3.3.1.2.{#SNMPINDEX}",
                                "key": "stream.active[{#SNMPINDEX}]",
                                "valuemap": {
                                    "name": "stream-active-value"
                                },
                                "trigger_prototypes": [
                                    {
                                        "uuid": "a00962ae389f4d518f3c6b66fd7f22fa",
                                        "expression": "max(/DEVABroadcast DB90TX by SNMP/stream.active[{#SNMPINDEX}],3m)=0",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/DEVABroadcast DB90TX by SNMP/stream.active[{#SNMPINDEX}])=1",
                                        "name": "Conexi\u00f3n {#SNMPINDEX} caida",
                                        "priority": "WARNING",
                                        "manual_close": "YES"
                                    }
                                ]
                            },
                            {
                                "uuid": "c1627cfa5f044a268e1df9ffbc1a60cb",
                                "name": "Conexi\u00f3n {#SNMPINDEX}: IP del Cliente",
                                "type": "SNMP_AGENT",
                                "snmp_oid": ".1.3.6.1.4.1.35833.8.3.3.1.3.{#SNMPINDEX}",
                                "key": "stream.clientIP[{#SNMPINDEX}]",
                                "value_type": "CHAR"
                            },
                            {
                                "uuid": "fe4160e72fa64f2287c59f256c3453a5",
                                "name": "Conexi\u00f3n {#SNMPINDEX}: Puerto Cliente",
                                "type": "SNMP_AGENT",
                                "snmp_oid": ".1.3.6.1.4.1.35833.8.3.3.1.4.{#SNMPINDEX}",
                                "key": "stream.clientPORT[{#SNMPINDEX}]"
                            },
                            {
                                "uuid": "b31d49f4346b4ede9a4cd513faab7148",
                                "name": "Conexi\u00f3n {#SNMPINDEX}: Tiempo de Conexi\u00f3n",
                                "type": "SNMP_AGENT",
                                "snmp_oid": ".1.3.6.1.4.1.35833.8.3.3.1.5.{#SNMPINDEX}",
                                "key": "stream.clientTIME[{#SNMPINDEX}]",
                                "units": "s",
                                "trigger_prototypes": [
                                    {
                                        "uuid": "5d31350d634b48388d24f30914c26bc1",
                                        "expression": "change(/DEVABroadcast DB90TX by SNMP/stream.clientTIME[{#SNMPINDEX}]) < 0",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "last(/DEVABroadcast DB90TX by SNMP/stream.clientTIME[{#SNMPINDEX}]) > 0",
                                        "name": "Conexi\u00f3n {#SNMPINDEX} reiniciada / reconectada",
                                        "priority": "INFO",
                                        "manual_close": "YES"
                                    }
                                ]
                            },
                            {
                                "uuid": "b5a075f30acd42a684a178c75294394f",
                                "name": "Conexi\u00f3n {#SNMPINDEX}: N\u00famero",
                                "type": "SNMP_AGENT",
                                "snmp_oid": ".1.3.6.1.4.1.35833.8.3.3.1.1.{#SNMPINDEX}",
                                "key": "stream.connectionNumber[{#SNMPINDEX}]"
                            }
                        ]
                    }
                ],
